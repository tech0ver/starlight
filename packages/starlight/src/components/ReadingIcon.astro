---
interface Props { status?: 'new' | 'seen' | 'read' }
const { status = 'new' } = Astro.props;
---

<span class="reading-icon" data-reading-icon data-status={status} data-favorite="false" aria-hidden="true">
	<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
		<g class="circle">
			<circle cx="12" cy="12" r="9" />
			<path class="half" d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" stroke="none" />
		</g>
		<g class="star">
			<path d="m12 2.75 2.86 5.8 6.39.93-4.63 4.51 1.1 6.37L12 17.35l-5.72 3.01 1.1-6.37-4.63-4.51 6.39-.93Z" />
			<path class="half" d="M12 2.75 9.14 8.55l-6.39.93 4.63 4.51-1.1 6.37L12 17.35Z" fill="currentColor" stroke="none" />
		</g>
		<path class="check" d="m8.8 11.9 2.1 2.1 4.2-4.2" />
	</svg>
</span>

<style>
	.reading-icon { display: inline-flex; flex: 0 0 auto; width: 1.25rem; height: 1.25rem; line-height: 0; }
	svg { width: 100%; height: 100%; }
	.star, .half, .check { display: none; }
	[data-favorite='true'] .circle { display: none; }
	[data-favorite='true'] .star { display: initial; }
	[data-status='seen'] .half, [data-status='read'] .check { display: initial; }
</style>
