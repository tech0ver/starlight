---
import ArticleTutor from './ArticleTutor.astro';
import config from 'virtual:tech0ver/config';

const { entry, sidebar } = Astro.locals.starlightRoute;
type SidebarEntry = (typeof sidebar)[number];
const containsCurrent = (item: SidebarEntry): boolean => item.type === 'link' ? item.isCurrent : item.entries.some(containsCurrent);
const section = sidebar.find((item) => item.type === 'group' && containsCurrent(item));
const { title, description } = entry.data;
const sourcePath = entry.filePath?.replaceAll('\\', '/').split('src/content/docs/')[1];
const glossarySlug = typeof config.glossaryRoute === 'string' ? config.glossaryRoute : 'glossary';
const escapedGlossarySlug = glossarySlug.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const isArticle = sourcePath && !new RegExp(`^(index|${escapedGlossarySlug})\\.mdx?$`).test(sourcePath) && entry.data.template !== 'splash';
---

<div class="article-heading">
	{section && <p class="article-section">{section.label}</p>}
	<h1 id="_top">{title}</h1>
	{description && <p class="article-description">{description}</p>}
</div>
{config.tutor.enabled && isArticle && sourcePath && <ArticleTutor title={title} sourcePath={sourcePath} />}

<style>
	.article-section { margin: 0 0 0.25rem; color: var(--sl-color-gray-3); font-size: var(--sl-text-xl); }
	.article-description {
		margin: 0.6rem 0 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-lg);
		line-height: 1.55;
	}
</style>
