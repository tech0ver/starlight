---
// The site title sits at the top of the left navigation (and of the
// mobile menu), above Starlight's sidebar.
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from './SidebarSublist.astro';
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ReadingState from './ReadingState.astro';
import config from 'virtual:tech0ver/config';
---

<div class="site-sidebar-brand">
  <SiteTitle />
</div>
<SidebarPersister>
  <SidebarSublist sublist={Astro.locals.starlightRoute.sidebar} />
</SidebarPersister>
<script is:inline define:vars={{ projectKey: config.reading.storageKey }}>
  (() => {
    const key = `tech0ver:sidebar:collapsed:${encodeURIComponent(projectKey)}`;
    const groups = document.querySelectorAll('details[data-sidebar-group]');
    const read = () => {
      try {
        const value = JSON.parse(localStorage.getItem(key) || '[]');
        return new Set(Array.isArray(value) ? value.filter((item) => typeof item === 'string') : []);
      } catch { return new Set(); }
    };
    const collapsed = read();
    groups.forEach((group) => {
      if (collapsed.has(group.dataset.sidebarGroup)) group.open = false;
    });
    // Ignore the toggle events queued by the initial HTML and restoration.
    setTimeout(() => groups.forEach((group) => group.addEventListener('toggle', () => {
      const state = read();
      if (group.open) state.delete(group.dataset.sidebarGroup);
      else state.add(group.dataset.sidebarGroup);
      try {
        if (state.size) localStorage.setItem(key, JSON.stringify([...state]));
        else localStorage.removeItem(key);
      } catch {}
    })), 0);
  })();
</script>
<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
{config.reading.enabled && <ReadingState />}

<style>
  /* Full sidebar width and the header's height, so its bottom line continues
     the header line without gaps. */
  .site-sidebar-brand {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    height: var(--sl-nav-height);
    margin: -1rem calc(-1 * var(--sl-sidebar-pad-x)) 0;
    padding: var(--sl-nav-pad-y) var(--sl-sidebar-pad-x);
    box-shadow: inset 0 -1px var(--sl-color-hairline-shade);
  }
  /* A 32px link centered in the 48px row, with room inside the 200px menu. */
  .site-sidebar-brand :global(.site-title) {
    height: var(--site-control);
    font-size: var(--sl-text-base);
    line-height: 1;
  }
  @media (width < 50rem) {
    .site-sidebar-brand :global(.site-title) { font-size: 18px; }
  }
</style>
