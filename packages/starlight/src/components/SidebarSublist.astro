---
// Adapted from Starlight's SidebarSublist to show consumer-owned planned topics.
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import { Icon, Badge } from '@astrojs/starlight/components';
import config from 'virtual:tech0ver/config';
import ReadingIcon from './ReadingIcon.astro';
import { articleKey } from '../lib/reading-state.mjs';
import { unwrittenTopics } from '../lib/planned-topics.mjs';
import type { PlannedTopic } from '../index';

type SidebarEntry = StarlightRouteData['sidebar'][number];
const hasCurrent = (entry: SidebarEntry): boolean => entry.type === 'link' ? entry.isCurrent : entry.entries.some(hasCurrent);

interface Props {
	sublist: SidebarEntry[];
	nested?: boolean;
	planned?: PlannedTopic[];
	groupPath?: string[];
}

const { sublist, nested, planned = [], groupPath = [] } = Astro.props;
const unwritten = (topics: PlannedTopic[]) => unwrittenTopics(topics, sublist, config.base, Astro.site?.origin ?? Astro.url.origin);
const topicLabel = (topic: PlannedTopic) => typeof topic === 'string' ? topic : topic.label;
const plannedFirst = nested ? [] : unwritten(config.plannedTopLevel);
---

<ul class:list={{ 'top-level': !nested }}>
	{plannedFirst.map((topic) => (
		<li>
			<span class="planned-topic" aria-disabled="true"><span class="large">{topicLabel(topic)}</span><span class="planned-badge">Planned</span></span>
		</li>
	))}
	{sublist.map((entry, index) => {
		const article = config.reading.enabled && nested && entry.type === 'link'
			? articleKey(entry.href, config.base, Astro.site?.origin ?? Astro.url.origin) : null;
		return (
		<li>
			{entry.type === 'link' ? (
				<div class:list={{ 'article-nav': article }}>
					{article && <button type="button" class="favorite-toggle" hidden data-favorite-article={article} data-article-label={entry.label} data-article-current={entry.isCurrent ? '' : undefined} aria-label={`${config.reading.labels.addFavorite}: ${entry.label}`} aria-pressed="false"><ReadingIcon /></button>}
				<a href={entry.href} aria-current={entry.isCurrent ? 'page' : undefined} class:list={[{ large: !nested }, entry.attrs.class]} {...entry.attrs}>
					<span>{entry.label}</span>
					{entry.badge && <Badge variant={entry.badge.variant} class={entry.badge.class} text={entry.badge.text} />}
				</a>
				</div>
			) : (
				<details open={hasCurrent(entry) || !entry.collapsed} data-sidebar-group={JSON.stringify([...groupPath, `${entry.label}:${sublist.slice(0, index).filter((item) => item.type === 'group' && item.label === entry.label).length}`])}>
					<summary>
						<span class="group-label">
							<span class="large">{entry.label}</span>
							{entry.badge && <Badge variant={entry.badge.variant} class={entry.badge.class} text={entry.badge.text} />}
						</span>
						<Icon name="right-caret" class="caret" size="1.25rem" />
					</summary>
					<Astro.self sublist={entry.entries} nested groupPath={[...groupPath, `${entry.label}:${sublist.slice(0, index).filter((item) => item.type === 'group' && item.label === entry.label).length}`]} planned={config.plannedTopics?.[entry.label] ?? []} />
				</details>
			)}
		</li>
		);
	})}
	{unwritten(planned).map((topic) => (
		<li>
			<span class="planned-topic" aria-disabled="true"><span>{topicLabel(topic)}</span><span class="planned-badge">Planned</span></span>
		</li>
	))}
</ul>

<style>
	@layer starlight.core {
		ul { --sl-sidebar-item-padding-inline: 0.5rem; list-style: none; padding: 0; }
		li { overflow-wrap: anywhere; }
		ul ul li { margin-inline-start: var(--sl-sidebar-item-padding-inline); border-inline-start: 1px solid var(--sl-color-hairline-light); padding-inline-start: var(--sl-sidebar-item-padding-inline); }
		.large { font-size: var(--sl-text-lg); font-weight: 600; color: var(--sl-color-white); }
		.top-level > li + li { margin-top: 0.75rem; }
		summary { display: flex; align-items: center; justify-content: space-between; padding: 0.2em var(--sl-sidebar-item-padding-inline); line-height: 1.4; cursor: pointer; user-select: none; }
		summary::marker, summary::-webkit-details-marker { display: none; }
		.caret { transition: transform 0.2s ease-in-out; flex-shrink: 0; }
		:global([dir='rtl']) .caret { transform: rotateZ(180deg); }
		[open] > summary .caret { transform: rotateZ(90deg); }
		a { display: block; border-radius: 0.25rem; text-decoration: none; color: var(--sl-color-gray-2); padding: 0.3em var(--sl-sidebar-item-padding-inline); line-height: 1.4; }
		a:hover, a:focus { color: var(--sl-color-white); }
		[aria-current='page'], [aria-current='page']:hover, [aria-current='page']:focus { font-weight: 600; color: var(--sl-color-text-invert); background-color: var(--sl-color-text-accent); }
		a > *:not(:last-child), .group-label > *:not(:last-child) { margin-inline-end: 0.25em; }
		@media (min-width: 50rem) { .top-level > li + li { margin-top: 0.5rem; } .large { font-size: var(--sl-text-base); } a { font-size: var(--sl-text-sm); } }
	}
	.planned-topic { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.4rem; padding: 0.3em var(--sl-sidebar-item-padding-inline); color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); line-height: 1.4; }
	.planned-topic > span:first-child { color: inherit; overflow-wrap: normal; }
	a:has(> :global(.sl-badge.default)) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.4rem; }
	a:has(> :global(.sl-badge.default)) > span:first-child { margin-inline-end: 0; overflow-wrap: normal; }
	.planned-badge, a > :global(.sl-badge.default) { flex-shrink: 0; padding: 0.1em 0.4em; border: 1px solid var(--sl-color-gray-5); border-radius: 0.3rem; color: var(--sl-color-gray-3); background: transparent; font: 400 0.65rem/1.4 var(--sl-font-system); }
	@media (width < 50rem) { .planned-topic { min-height: 2.75rem; padding-block: 0.55rem; font-size: var(--sl-text-base); } }
</style>
