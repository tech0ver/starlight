---
// Copy of Starlight's PageSidebar: the desktop table of contents shows from 50rem.
import MobileTableOfContents from 'virtual:starlight/components/MobileTableOfContents';
import TableOfContents from 'virtual:starlight/components/TableOfContents';
---

{
	Astro.locals.starlightRoute.toc && (
		<>
			<div class="md:sl-hidden">
				<MobileTableOfContents />
			</div>
			<div class="right-sidebar-panel sl-hidden md:sl-block">
				<div class="sl-container">
					<TableOfContents />
				</div>
			</div>
		</>
	)
}

<script>
	function keepCurrentTocVisible() {
		const toc = document.querySelector('starlight-toc');
		const sidebar = toc?.closest<HTMLElement>('.right-sidebar');
		if (!toc || !sidebar) return;

		const revealCurrent = () => {
			if (!matchMedia('(min-width: 50rem)').matches) return;
			const current = toc.querySelector<HTMLAnchorElement>('a[aria-current="true"]');
			if (!current) return;

			const bounds = current.getBoundingClientRect();
			const container = sidebar.getBoundingClientRect();
			const top = Math.max(container.top, document.querySelector('header')?.getBoundingClientRect().bottom ?? 0) + 8;
			const bottom = container.bottom - 8;
			// Scroll only the navigation panel; the article keeps its reading position.
			if (bounds.top < top) sidebar.scrollTop += bounds.top - top;
			else if (bounds.bottom > bottom) sidebar.scrollTop += bounds.bottom - bottom;
		};

		new MutationObserver(revealCurrent).observe(toc, {
			subtree: true,
			attributes: true,
			attributeFilter: ['aria-current'],
		});
		window.addEventListener('resize', revealCurrent);
		requestAnimationFrame(revealCurrent);
	}

	keepCurrentTocVisible();

	// Keep the entry point here so Astro includes it when installed from a package.
	async function trackReadingPosition() {
		const toc = document.querySelector('starlight-toc');
		if (!toc) return;

		const sections = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
			.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
			.filter((section): section is HTMLElement => section !== null);
		if (sections.length < 2) return;

		// Wait for the text layout without waiting for unrelated external resources.
		await document.fonts.ready;

		const updateUrl = () => {
			const root = document.documentElement;
			const padding = parseFloat(getComputedStyle(root).scrollPaddingTop) || 0;
			let current = sections[0];
			for (const section of sections) {
				const margin = parseFloat(getComputedStyle(section).scrollMarginTop) || 0;
				if (section.getBoundingClientRect().top > padding + margin + 2) break;
				current = section;
			}

			const url = new URL(window.location.href);
			url.hash = current.id === '_top' ? '' : current.id;
			if (url.href !== window.location.href) {
				// Save the section without scrolling or adding a Back button entry.
				history.replaceState(history.state, '', url);
			}
		};

		let timeout: ReturnType<typeof setTimeout>;
		requestAnimationFrame(() => {
			window.addEventListener('scroll', () => {
				clearTimeout(timeout);
				// Wait for smooth anchor navigation and continuous scrolling to settle.
				timeout = setTimeout(updateUrl, 150);
			}, { passive: true });
		});
	}

	void trackReadingPosition();
</script>

<style>
	@layer starlight.core {
		.right-sidebar-panel {
			padding: 1rem var(--sl-sidebar-pad-x);
		}
		.sl-container {
			width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
		}
		.right-sidebar-panel :global(h2) {
			color: var(--sl-color-white);
			font-size: var(--sl-text-h5);
			font-weight: 600;
			line-height: var(--sl-line-height-headings);
			margin-bottom: 0.5rem;
		}
		.right-sidebar-panel :global(:where(a)) {
			display: block;
			font-size: var(--sl-text-xs);
			text-decoration: none;
			color: var(--sl-color-gray-3);
			overflow-wrap: anywhere;
		}
		.right-sidebar-panel :global(:where(a):hover) {
			color: var(--sl-color-white);
		}
		@media (min-width: 72rem) {
			.sl-container {
				max-width: calc(
					(
						(
								100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 *
									var(--sl-sidebar-pad-x)
							) * 0.25 /* MAGIC NUMBER 🥲 */
					)
				);
			}
		}
	}
</style>
