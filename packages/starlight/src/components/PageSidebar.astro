---
// Copy of Starlight's PageSidebar: the desktop table of contents shows from 50rem.
import MobileTableOfContents from 'virtual:starlight/components/MobileTableOfContents';
import TableOfContents from 'virtual:starlight/components/TableOfContents';
---

{
	Astro.locals.starlightRoute.toc && (
		<>
			<div class="md:sl-hidden">
				<MobileTableOfContents />
			</div>
			<div class="right-sidebar-panel sl-hidden md:sl-block">
				<div class="sl-container">
					<TableOfContents />
				</div>
			</div>
		</>
	)
}

<script>
	function keepCurrentTocVisible() {
		const toc = document.querySelector('starlight-toc');
		const sidebar = toc?.closest<HTMLElement>('.right-sidebar');
		if (!toc || !sidebar) return;

		const revealCurrent = () => {
			if (!matchMedia('(min-width: 50rem)').matches) return;
			const current = toc.querySelector<HTMLAnchorElement>('a[aria-current="true"]');
			if (!current) return;

			const bounds = current.getBoundingClientRect();
			const container = sidebar.getBoundingClientRect();
			const top = Math.max(container.top, document.querySelector('header')?.getBoundingClientRect().bottom ?? 0) + 8;
			const bottom = container.bottom - 8;
			// Scroll only the navigation panel; the article keeps its reading position.
			if (bounds.top < top) sidebar.scrollTop += bounds.top - top;
			else if (bounds.bottom > bottom) sidebar.scrollTop += bounds.bottom - bottom;
		};

		new MutationObserver(revealCurrent).observe(toc, {
			subtree: true,
			attributes: true,
			attributeFilter: ['aria-current'],
		});
		window.addEventListener('resize', revealCurrent);
		requestAnimationFrame(revealCurrent);
	}

	keepCurrentTocVisible();
</script>

<style>
	@layer starlight.core {
		.right-sidebar-panel {
			padding: 1rem var(--sl-sidebar-pad-x);
		}
		.sl-container {
			width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
		}
		.right-sidebar-panel :global(h2) {
			color: var(--sl-color-white);
			font-size: var(--sl-text-h5);
			font-weight: 600;
			line-height: var(--sl-line-height-headings);
			margin-bottom: 0.5rem;
		}
		.right-sidebar-panel :global(:where(a)) {
			display: block;
			font-size: var(--sl-text-xs);
			text-decoration: none;
			color: var(--sl-color-gray-3);
			overflow-wrap: anywhere;
		}
		.right-sidebar-panel :global(:where(a):hover) {
			color: var(--sl-color-white);
		}
		@media (min-width: 72rem) {
			.sl-container {
				max-width: calc(
					(
						(
								100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 *
									var(--sl-sidebar-pad-x)
							) * 0.25 /* MAGIC NUMBER 🥲 */
					)
				);
			}
		}
	}
</style>
